# oído 环境示例（只写非秘密）
# 数据根（生产建议 ~/Data/oido；测试用临时目录覆盖）
# OIDO_DATA_ROOT=~/Data/oido
# feature flags（默认全关；每个生产接入必须可退）
# OIDO_FLAG_INGEST=false
# OIDO_FLAG_OFFLINE_ANALYSIS=false
# OIDO_FLAG_MCP_TOOLS=false
# OIDO_FLAG_EST_EVIDENCE=false
# OIDO_FLAG_SIREN_SIDECAR=false
# OIDO_FLAG_REALTIME=false
# OIDO_FLAG_MEMORY_LINKS=false
# OIDO_FLAG_PERSONAL_BASELINE=false
