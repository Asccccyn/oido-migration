{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oido:evidence.v1",
  "title": "oído 标准证据（EXEC §3.5）",
  "type": "object",
  "required": ["schema_version", "kind", "feature", "method", "method_version", "input_variant_id", "timebase_id", "range", "quality_flags"],
  "properties": {
    "schema_version": {"const": "oido.v1"},
    "evidence_id": {"type": "string", "pattern": "^ev_"},
    "audio_id": {"type": "string"},
    "analysis_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["measurement", "model_detection", "model_description"]},
    "feature": {
      "type": "string",
      "not": {
        "enum": ["emotion", "mood", "affect", "emotion_score", "mood_score",
                 "affect_score", "sentiment", "feeling"]
      }
    },
    "value": {"type": ["number", "null"]},
    "below_floor": {"type": "boolean"},
    "unit": {"type": "string"},
    "method": {"type": "string", "minLength": 1},
    "method_version": {"type": "string", "minLength": 1},
    "input_variant_id": {"type": "string"},
    "timebase_id": {"type": "string"},
    "range": {
      "type": "object",
      "required": ["start_sample", "end_sample"],
      "properties": {
        "start_sample": {"type": "integer", "minimum": 0},
        "end_sample": {"type": "integer", "minimum": 1}
      }
    },
    "parameters": {"type": "object"},
    "score_kind": {"type": "string"},
    "raw_score": {"type": "number"},
    "model_version": {"type": "string"},
    "calibration": {"type": ["string", "null"]},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "fixture_only": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "measurement"}}},
      "then": {"required": ["unit"]}
    },
    {
      "if": {"properties": {"kind": {"const": "model_detection"}}},
      "then": {"required": ["score_kind", "raw_score", "model_version"]}
    }
  ],
  "$comment": "emotion/affect/mood 分类不属于 oído v1 合法证据（D04/B20）。允许的可听事件标签见 ALLOWED_SOUND_EVENTS。",
  "x-forbidden-keys": ["emotion", "mood", "affect", "sentiment", "feeling"]
}
